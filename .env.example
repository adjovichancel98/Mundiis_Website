# Contact form email delivery — https://resend.com (free tier available)
# 1. Create a Resend account and generate an API key.
# 2. For production, verify your own sending domain in Resend and set
#    CONTACT_FROM_EMAIL to an address on that domain (e.g. contact@mundiis.com).
#    Until you do, the default onboarding@resend.dev sender works but is
#    rate-limited and meant for testing.
RESEND_API_KEY=

# Where contact form submissions are sent. Defaults to chancel@mundiis.com if unset.
CONTACT_TO_EMAIL=chancel@mundiis.com

# Sender address shown on outgoing emails. Defaults to a Resend sandbox address if unset.
CONTACT_FROM_EMAIL=Mundiis <onboarding@resend.dev>
